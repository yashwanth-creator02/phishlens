# Copy to .env  (never commit .env). All backend settings use the PHISHLENS_ prefix.
PHISHLENS_APP_ENV=dev

# Docker Compose uses this path (the data_db volume is mounted at /app/data_db).
# Local development without Docker: use sqlite:///./phishlens.db instead.
# Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
PHISHLENS_DATABASE_URL=sqlite:////app/data_db/phishlens.db

# "disabled" = single dev user, no login (local only!). "supabase" = verify Supabase access tokens.
PHISHLENS_AUTH_MODE=disabled
PHISHLENS_SUPABASE_URL=
PHISHLENS_SUPABASE_ANON_KEY=
PHISHLENS_SUPABASE_JWT_SECRET=
PHISHLENS_SUPABASE_JWKS_URL=

# Shared secret your inbound-email provider sends in the X-Webhook-Secret header. CHANGE IT.
PHISHLENS_WEBHOOK_SECRET=change-me
PHISHLENS_ALIAS_DOMAIN=phishlens.example

# Risk bands (provisional; retune on validation data)
PHISHLENS_BAND_LOW_MAX=29
PHISHLENS_BAND_HIGH_MIN=70

# Frontend (build-time): enable Supabase login in the web app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
