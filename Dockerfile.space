FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PHISHLENS_AUTO_TRAIN_DEMO=true \
    PHISHLENS_MODEL_DIR=/app/models \
    PHISHLENS_STORAGE_DIR=/app/storage \
    PHISHLENS_DATABASE_URL=sqlite:////app/data_db/phishlens.db \
    PORT=7860

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-postgres.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-postgres.txt

COPY app ./app
COPY training ./training
COPY data ./data
COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x entrypoint.sh && mkdir -p /app/models /app/storage /app/reports /app/data_db

EXPOSE 7860
ENTRYPOINT ["./entrypoint.sh"]
